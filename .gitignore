# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# pnpm is the source of truth (pnpm-lock.yaml is committed); ignore npm-generated
# lockfiles so the postinstall + setup-designer script don't pollute the repo.
package-lock.json

# Pre-pack scrubbed registry for ds-engine. Generated by `npm run scrub` /
# `prepack`. Source of truth lives at packages/ds-engine/registry/.
packages/ds-engine/dist-registry/

# Build
dist/
build/
.next/
out/

# npm/pnpm pack tarballs (generated by `npm pack` / `pnpm pack`)
*.tgz

# Playwright e2e output (regenerated by `pnpm e2e`)
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Role-walkthrough screenshots (build evidence; the findings report is the committed artifact)
e2e/.screenshots/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
_archive/
.tempmediaStorage/
ai/brain/
ai/knowledge/
ai/logs/
.superpowers/

# Generated health check reports
ai/tracking/rule-health-latest.md
ai/tracking/rule-health-latest.json

# Claude Code per-machine config and runtime artifacts
.claude/settings.local.json
.claude/*.lock
# Local git worktrees (full repo copies; never tracked from the main tree)
.claude/worktrees/

# Worktree preview server state + logs (ai/scripts/worktree-preview.mjs). Kept in
# the main checkout on purpose: a state file written INSIDE a worktree shows up as
# untracked on any branch whose .gitignore predates it, which makes the tree look
# dirty and the sweep refuse to reclaim it forever.
.claude/previews/

# Kombai tool local artifacts (not part of this project)
.kombai/

# Prisma generated client + turbo cache
**/src/generated/
.turbo/

# ShipStudio metadata
.shipstudio/

# TypeScript incremental build cache (emitted by `tsc`; never committed).
tsconfig.tsbuildinfo
*.tsbuildinfo

# Vite dep-optimize cache. Anchored to the checkout root (not node_modules) so a
# worktree whose node_modules is a junction to the main checkout does not share it —
# two Vite servers rewriting one cache serve two React generations and the app dies
# with a null hook dispatcher. See vite.config.ts.
.vite/

# Database dumps: real data, handed over separately, never committed.
dumps/
