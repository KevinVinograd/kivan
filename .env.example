# Front-end env. Copy to `.env.local` (gitignored) and adjust.
# The API has its own file: `apps/api/.env.example`.

# Where the front talks to the API. Defaults to the local API when unset.
VITE_API_URL=http://localhost:3010


# --- Dev-only auto-login (optional) ---
#
# Session tokens live in `localStorage`, which is scoped per ORIGIN — and the port is
# part of the origin. So a front served on a new port boots logged out and bounces you to /login. Set the three vars
# below and the app logs in on boot with a seeded account, on any port.
#
# Safety: this path exists ONLY in a dev build (it is stripped from a production
# bundle, not merely disabled), it is off unless the flag is exactly `1`, and it is
# disabled under browser automation so it can never leak into the e2e suite.
#
# NEVER put a real or production credential here. These are the local seed values
# created by `./scripts/dev-up.sh`.
VITE_DEV_AUTOLOGIN=1
VITE_DEV_AUTOLOGIN_EMAIL=owner@studio.test
VITE_DEV_AUTOLOGIN_PASSWORD=owner1234
