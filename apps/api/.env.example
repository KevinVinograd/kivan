# Copy to .env for local dev. @hold/config loads this file from the cwd at boot
# and fails fast if a required var is missing/invalid.

# The API connects as the non-superuser app role created by scripts/create-db.sh.
DATABASE_URL=postgresql://kivan_app:app@localhost:5477/kivan

# JWT signing secret — must be >= 32 chars (a placeholder won't pass validation).
JWT_SECRET=kivan-dev-secret-0123456789abcdefghij

PORT=3010
HOST=127.0.0.1
LOG_LEVEL=info

# 0 = trust no proxy (direct). Behind one reverse proxy (nginx, Caddy…) set to 1.
TRUST_PROXY_HOPS=0

# Tighter limit for the public auth routes (brute-force protection).
RATE_LIMIT_AUTH=10

